{
  "@context": {
    "@version": 1.1,
    "giraph": "https://giraph.apache.org/schema/",
    "schema": "https://schema.org/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "ApplicationsResponse": "giraph:ApplicationsResponse",
    "apps": {
      "@id": "giraph:apps",
      "@type": "@id"
    },
    "ApplicationResponse": "giraph:ApplicationResponse",
    "app": {
      "@id": "giraph:app",
      "@type": "xsd:string"
    },
    "ApplicationInfo": "giraph:ApplicationInfo",
    "id": {
      "@id": "giraph:id",
      "@type": "xsd:string"
    },
    "name": "schema:name",
    "applicationType": {
      "@id": "giraph:applicationType",
      "@type": "xsd:string"
    },
    "state": {
      "@id": "giraph:state",
      "@type": "xsd:string"
    },
    "finalStatus": {
      "@id": "giraph:finalStatus",
      "@type": "xsd:string"
    },
    "progress": {
      "@id": "giraph:progress",
      "@type": "xsd:integer"
    },
    "trackingUrl": {
      "@id": "giraph:trackingUrl",
      "@type": "xsd:string"
    },
    "queue": {
      "@id": "giraph:queue",
      "@type": "xsd:string"
    },
    "startedTime": {
      "@id": "giraph:startedTime",
      "@type": "xsd:integer"
    },
    "finishedTime": {
      "@id": "giraph:finishedTime",
      "@type": "xsd:integer"
    },
    "elapsedTime": {
      "@id": "giraph:elapsedTime",
      "@type": "xsd:integer"
    },
    "numContainers": {
      "@id": "giraph:numContainers",
      "@type": "xsd:integer"
    },
    "ClusterMetricsResponse": "giraph:ClusterMetricsResponse",
    "clusterMetrics": {
      "@id": "giraph:clusterMetrics",
      "@type": "@id"
    }
  }
}